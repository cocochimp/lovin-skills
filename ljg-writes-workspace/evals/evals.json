{
  "skill_name": "ljg-writes",
  "evals": [
    {
      "id": 1,
      "prompt": "帮我写一篇文章，观点：远程办公比坐班更高效",
      "expected_output": "一篇1000-1500字的批判性文章，层层剖析'远程办公更高效'这个观点，有反直觉发现",
      "files": [],
      "assertions": [
        {
          "id": "word-count",
          "text": "文章字数在1000-1500之间",
          "type": "programmatic"
        },
        {
          "id": "no-listicle",
          "text": "文章不是要点罗列式，而是层层递进的论证结构",
          "type": "qualitative"
        },
        {
          "id": "has-counterintuitive",
          "text": "至少有一个反直觉的发现或转折",
          "type": "qualitative"
        },
        {
          "id": "no-ai-cliches",
          "text": "没有AI拐杖词（标志着、见证了、充满活力、值得注意的是等）",
          "type": "programmatic"
        },
        {
          "id": "conversational-tone",
          "text": "语气像在跟聪明朋友说话，不像在写公文或演讲稿",
          "type": "qualitative"
        },
        {
          "id": "file-output",
          "text": "输出为.md文件，保存在docs/目录下",
          "type": "programmatic"
        },
        {
          "id": "header-format",
          "text": "文件头包含标题和日期+作者信息",
          "type": "programmatic"
        }
      ]
    },
